@model AssetsManagement_Admin.Models.LoginUser

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" dir="ltr" data-nav-layout="vertical" data-vertical-style="overlay" data-theme-mode="dark" data-header-styles="dark" data-menu-styles="dark" data-toggled="close">

<head>
    <meta charset="UTF-8">
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Fixed Asset Verification Login</title>
    <meta name="Description" content="Fixed Asset Verification">
    <meta name="Author" content="URCFO Pvt Ltd">
    <meta name="keywords" content="admin, dashboard, bootstrap template, admin dashboard, bootstrap admin, template dashboard, html css templates, html and css, admin dashboard template, bootstrap dashboard, admin panel, html, html template, bootstrap admin panel, bootstrap html template">
    <link rel="icon" href="~/assets/images/brand-logos/fav.ico" type="image/x-icon">
    <script src="~/assets/js/authentication-main.js"></script>
    <link id="style" href="~/assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/styles.min.css" rel="stylesheet">
    <link href="~/assets/css/icons.min.css" rel="stylesheet">
</head>

<body class="main-body login-page">
    <script>
document.addEventListener('DOMContentLoaded', function () {

    var toastSuccess = document.getElementById('solid-successToast');
    var toastDanger  = document.getElementById('solid-dangerToast');
    var toastInfo    = document.getElementById('solid-infoToast');

    @* SUCCESS *@
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            if (toastSuccess) {
                new bootstrap.Toast(toastSuccess).show();
            }
        </text>
    }

    @* ERROR *@
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            if (toastDanger) {
                new bootstrap.Toast(toastDanger).show();
            }
        </text>
    }

    @* INFO *@
    @if (TempData["InfoMessage"] != null)
    {
        <text>
            if (toastInfo) {
                new bootstrap.Toast(toastInfo).show();
            }
        </text>
    }

});
    </script>


    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="solid-successToast" class="toast colored-toast bg-success text-fixed-white" role="alert" aria-live="assertive"
             aria-atomic="true">
            <div class="toast-header bg-success text-fixed-white">
                <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
                <strong class="me-auto">Message</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"
                        aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["SuccessMessage"]
            </div>
        </div>
        <div id="solid-dangerToast" class="toast colored-toast bg-danger text-fixed-white" role="alert" aria-live="assertive"
             aria-atomic="true">
            <div class="toast-header bg-danger text-fixed-white">
                <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
                <strong class="me-auto">Message</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"
                        aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["ErrorMessage"]
            </div>
        </div>
        <div id="solid-infoToast" class="toast colored-toast bg-info text-fixed-white" role="alert" aria-live="assertive"
             aria-atomic="true">
            <div class="toast-header bg-info text-fixed-white">
                <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
                <strong class="me-auto">Message</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"
                        aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["InfoMessage"]
            </div>
        </div>
    </div>
    <div class="page">
        <div class="my-auto page page-h">
            <div class="main-signin-wrapper">
                <div class="main-card-signin d-md-flex wd-100p">
                    <div class="wd-md-50p login d-none d-md-block page-signin-style p-5 text-white">
                        <div class="my-auto authentication-pages">
                            <div>
                                <center><img src="~/assets/images/brand-logos/desktop-dark.png"  alt="logo" style="height:99px"></center>
                                <h5 class="mb-4 text-fixed-white">
                                    Modern Fixed Asset Verification Platform & Admin Dashboard  
                                </h5>
                                <p class="mb-2 text-fixed-white">
                                    URCFO provides a powerful and easy-to-use platform for managing fixed asset verification, asset audits, and inventory validation programs. Our system helps organizations and administrators collaborate efficiently to maintain accurate records, ensure compliance, and streamline asset management operations.
                                </p>`
                            </div>
                        </div>
                    </div>
                    <div class="p-5 wd-md-50p bg-white">
                        @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { @class = "max-width-auto", @id = "Login" }))
                        {
                            <div class="main-signin-header">
                                <h2>Welcome back!</h2>
                                <h4>Please sign in to continue</h4>
                                <div class="form-group">
                                    <label class="text-muted mb-1">Email</label>
                                    @Html.TextBoxFor(m => m.Username, new { @maxLength = 500, @class = "form-control text-muted", @placeholder = "Enter your email", required = "required", autocomplete = "off" })
                                </div>
                                <div class="form-group">
                                    <label class="text-muted mb-1">Password</label>
                                    @Html.PasswordFor(m => m.Password, new { @maxLength = 500, @class = "form-control text-muted", @placeholder = "Enter your password", required = "required", autocomplete = "off" })
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary btn-block">Log In</button>
                                </div>

                            </div>
                        }
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
