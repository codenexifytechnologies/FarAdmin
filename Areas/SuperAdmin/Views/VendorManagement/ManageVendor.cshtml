
@{
    ViewBag.Title = "ManageVendor";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.3.0/css/responsive.bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.bootstrap5.min.css">
<link href="~/assets/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />


<script>
document.addEventListener('DOMContentLoaded', function () {

    var toastSuccess = document.getElementById('solid-successToast');
    var toastDanger  = document.getElementById('solid-dangerToast');
    var toastInfo    = document.getElementById('solid-infoToast');

    @* SUCCESS *@
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            if (toastSuccess) {
                new bootstrap.Toast(toastSuccess).show();
            }
        </text>
    }

    @* ERROR *@
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            if (toastDanger) {
                new bootstrap.Toast(toastDanger).show();
            }
        </text>
    }

    @* INFO *@
    @if (TempData["InfoMessage"] != null)
    {
        <text>
            if (toastInfo) {
                new bootstrap.Toast(toastInfo).show();
            }
        </text>
    }

});
</script>


<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="solid-successToast" class="toast colored-toast bg-success text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-success text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["SuccessMessage"]
        </div>
    </div>
    <div id="solid-dangerToast" class="toast colored-toast bg-danger text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-danger text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["ErrorMessage"]
        </div>
    </div>
    <div id="solid-infoToast" class="toast colored-toast bg-info text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-info text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["InfoMessage"]
        </div>
    </div>
</div>



<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">Partner Directory</div>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Count > 0)
                {
                    <table id="file-export" class="table table-bordered text-nowrap" style="width:100%">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Contact No</th>
                                <th scope="col">Contact Email</th>
                                <th scope="col">Company Name</th>
                                <th scope="col">Branch Name</th>
                                <th scope="col">Password</th>
                                <th scope="col">Submit Report Visible</th>
                                <th scope="col">Both Camera Option Visible</th>
                                <th scope="col">Static Location Details Visible</th>
                                <th scope="col">Status</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.VendorName</td>
                                    <td>@item.VendorContactNo</td>
                                    <td>@item.VendorEmailId</td>
                                    <td>@item.VendorCompany</td>
                                    <td>@item.VendorBranch</td>
                                    <td>@item.VendorPassword</td>
                                    <td>
                                        <center>
                                            @Html.Raw(item.VendorVisibleReport == true
                                            ? "<span class='badge bg-success-transparent'>Visible</span>"
                                            : "<span class='badge bg-light text-dark'>Not Visible</span>")
                                        </center>
                                    </td>

                                    <td>
                                        <center>
                                            @Html.Raw(item.IsBothCameraOptionVisible == true
                                            ? "<span class='badge bg-success-transparent'>Visible</span>"
                                            : "<span class='badge bg-light text-dark'>Not Visible</span>")
                                        </center>
                                    </td>

                                    <td>
                                        <center>
                                            @Html.Raw(item.IsStaticLocationVisible == true
                                            ? "<span class='badge bg-success-transparent'>Visible</span>"
                                            : "<span class='badge bg-light text-dark'>Not Visible</span>")
                                        </center>
                                    </td>

                                    <td>
                                        <center>
                                            @Html.Raw(item.IsActive == 1
                                            ? "<span class='badge bg-success-transparent'>Active</span>"
                                            : "<span class='badge bg-light text-dark'>InActive</span>")
                                        </center>
                                    </td>
                                    <td>
                                        <div class="hstack gap-2 fs-15">
                                            <a href="@Url.Action("EditManageVendor","VendorManagement",new {Id=item.VendorId})" class="btn btn-icon btn-sm btn-info-light rounded-pill"><i class="ri-edit-line"></i></a>
                                            <a href="@Url.Action("DeleteVendor","VendorManagement",new {Id=item.VendorId})" class="btn btn-icon btn-sm btn-danger-light rounded-pill delete-Vendor"><i class="ri-delete-bin-line"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <h4>No Data Found..</h4>
                }
            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.1.min.js" integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ=" crossorigin="anonymous"></script>

<!-- Datatables Cdn -->
<script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.3.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.print.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<!-- Internal Datatables JS -->
<script src="~/assets/js/datatables.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/jquery.js"></script>
<script>
    $(document).on("click", ".delete-Vendor", function (e) {
        e.preventDefault();
        var url = $(this).attr("href");

        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                showLoader();
                window.location.href = url;
            }
        });
    });
</script>

