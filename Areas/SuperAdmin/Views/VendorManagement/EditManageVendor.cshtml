@model AssetsManagement_Admin.Areas.SuperAdmin.Data.Vendor
@{
    ViewBag.Title = "EditManageVendor";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_Layout.cshtml";
}


<script>

    document.addEventListener('DOMContentLoaded', function () {
    var toastSuccess = document.getElementById('solid-successToast');
    var toastDanger  = document.getElementById('solid-dangerToast');
    var toastInfo    = document.getElementById('solid-infoToast');

    @* SUCCESS *@
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            if (toastSuccess) {
                new bootstrap.Toast(toastSuccess).show();
            }
        </text>
    }

    @* ERROR *@
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            if (toastDanger) {
                new bootstrap.Toast(toastDanger).show();
            }
        </text>
    }

    @* INFO *@
    @if (TempData["InfoMessage"] != null)
    {
        <text>
            if (toastInfo) {
                new bootstrap.Toast(toastInfo).show();
            }
        </text>
    }

});
</script>


<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="solid-successToast" class="toast colored-toast bg-success text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-success text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["SuccessMessage"]
        </div>
    </div>
    <div id="solid-dangerToast" class="toast colored-toast bg-danger text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-danger text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["ErrorMessage"]
        </div>
    </div>
    <div id="solid-infoToast" class="toast colored-toast bg-info text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-info text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["InfoMessage"]
        </div>
    </div>
</div>


<div class="row row-sm">
    <div class="col-lg-12">
        <div class="card">
            @using (Html.BeginForm("EditManageVendor", "VendorManagement", new { area = "SuperAdmin" }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "max-width-auto", @id = "EditManageVendor" }))
            {
                <div class="card-body">
                    <div class="mb-4 main-content-label">Vendor Information</div>
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Name *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.HiddenFor(m => m.VendorId)
                                @Html.TextBoxFor(m => m.VendorName, new { @class = "form-control", @placeholder = "Name", autocomplete = "off", maxlength = "50", onkeypress = "return isTextOnly(event)" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Contact No *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.TextBoxFor(m => m.VendorContactNo, new { @class = "form-control", @placeholder = "Contact No", autocomplete = "off", maxlength = "10", onkeypress = "return isNumber(event)" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Email Id *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.TextBoxFor(m => m.VendorEmailId, new { @class = "form-control", @placeholder = "Email Id", autocomplete = "off", maxlength = "50" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Select Company *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.DropDownListFor(model => model.VendorCompany, (SelectList)ViewBag.Company, "All", new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Select Branch *</label>
                            </div> <div class="form-group col-md-9">
                                <select id="VendorBranch" name="VendorBranch" class="form-select">
                                    <option value="">All</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Create Password *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.TextBoxFor(m => m.VendorPassword, new { @class = "form-control", @placeholder = "Create Password", autocomplete = "off", maxlength = "15" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Submit Report Visible</label>
                            </div>
                            <div class="form-group col-md-9">

                                <div class="form-check form-check-md">
                                    @Html.CheckBoxFor(m => m.VendorVisibleReport,
                                      new { @class = "form-check-input" })

                                    <label class="form-check-label ms-1" for="VendorVisibleReport">
                                        Visible
                                    </label>
                                </div>

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Both Camera Option Visible</label>
                            </div>
                            <div class="form-group col-md-9">

                                <div class="form-check form-check-md">
                                    @Html.CheckBoxFor(m => m.IsBothCameraOptionVisible,
                                        new { @class = "form-check-input" })

                                    <label class="form-check-label ms-1" for="IsBothCameraOptionVisible">
                                        Visible
                                    </label>
                                </div>

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Static Location Details Visible</label>
                            </div>
                            <div class="form-group col-md-9">

                                <div class="form-check form-check-md">
                                    @Html.CheckBoxFor(m => m.IsStaticLocationVisible,
                                        new { @class = "form-check-input" })

                                    <label class="form-check-label ms-1" for="IsStaticLocationVisible">
                                        Visible
                                    </label>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary waves-effect waves-light">Update User</button>
                </div>
            }
        </div>
    </div>
</div>
<script src="~/assets/js/jquery/jquery.js"></script>
<script src="~/assets/js/jquery-validation/jquery.validate.min.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        var _CompanyID = $('#VendorCompany').val();
            $("#VendorBranch").empty();
            var selectedBranchText = '@Model.VendorBranch';
            $.ajax({
                url: '../getBranch',
                type: 'GET',
                data: { CompanyID: _CompanyID },

                success: function (data) {
                    $("#VendorBranch").append(
                        '<option value="">All</option>'
                    );
                    $.each(data.data[0], function (i, state) {
                        debugger
                        $("#VendorBranch").append(
                            '<option value="' + state.Value + '">' +
                            state.Text +
                            '</option>'
                        );
                    });

                    $("#VendorBranch option").each(function () {
                        ;
                        if ($(this).text().trim() === selectedBranchText) {
                            $(this).prop("selected", true);
                        }
                    });
                }
            });
    });
</script>

<script>
    function isNumber(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;
        if (charCode < 48 || charCode > 57) {
            return false;
        }
        return true;
    }
</script>

<script>
    function isTextOnly(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;

        // Allow A-Z (65-90), a-z (97-122), and space (32)
        if (
            (charCode >= 65 && charCode <= 90) ||
            (charCode >= 97 && charCode <= 122) ||
            charCode === 32
        ) {
            return true;
        }
        return false;
    }
</script>