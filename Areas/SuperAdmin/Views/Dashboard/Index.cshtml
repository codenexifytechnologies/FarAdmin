<script src="~/assets/js/jquery/jquery.js"></script>
<script src="~/assets/js/jquery-validation/jquery.validate.min.js"></script>
<script>
    $(document).ready(function () {
        var companyId = $('#CompanyId').val();

        if (companyId > 0) {

            $("#VendorBranch").prop("disabled", false);
            $("#Region").prop("disabled", false);
            $("#State").prop("disabled", false);
            $("#btnDownload").prop("disabled", false);
        }
        else {
            $("#VendorBranch").prop("disabled", true);
            $("#Region").prop("disabled", true);
            $("#State").prop("disabled", true);
            $("#btnDownload").prop("disabled", true);
        }
        });


    function ddlchange() {
        $('#loader').show();
        var companyId = $('#CompanyId').val();

        if (companyId > 0) {

            $("#VendorBranch").prop("disabled", false);
            $("#Region").prop("disabled", false);
            $("#State").prop("disabled", false);
            $("#btnDownload").prop("disabled", false);

            // STORE CURRENT SELECTED VALUES
            var branchname = $('#VendorBranch').val();
            var region = $('#Region').val();
            var state = $('#State').val();

            // CLEAR DROPDOWNS
            $("#VendorBranch").empty().append('<option value="">All</option>');
            $("#Region").empty().append('<option value="">All</option>');
            $("#State").empty().append('<option value="">All</option>');

            $.ajax({
                url: '@Url.Action("getFilterData", "Dashboard")',
                type: 'GET',
                data: {
                    CompanyID: companyId,
                    BranchName: branchname,
                    Region: region,
                    State: state
                },
                success: function (data) {
                    // VendorBranch
                    $.each(data.data[0], function (i, item) {

                        var selected = (item.Value == branchname) ? 'selected' : '';

                        $("#VendorBranch").append(
                            '<option value="' + item.Value + '" ' + selected + '>' +
                            item.Text +
                            '</option>'
                        );
                    });

                    // Region
                    $.each(data.data[1], function (i, item) {

                        var selected = (item.Value == region) ? 'selected' : '';

                        $("#Region").append(
                            '<option value="' + item.Value + '" ' + selected + '>' +
                            item.Text +
                            '</option>'
                        );
                    });

                    // State
                    $.each(data.data[2], function (i, item) {

                        var selected = (item.Value == state) ? 'selected' : '';

                        $("#State").append(
                            '<option value="' + item.Value + '" ' + selected + '>' +
                            item.Text +
                            '</option>'
                        );
                    });
                },
                error: function () {
                    alert("Failed to load.");
                }
            });
        }
        else {

            $("#VendorBranch").prop("disabled", true);
            $("#Region").prop("disabled", true);
            $("#State").prop("disabled", true);
            $("#btnDownload").prop("disabled", true);
        }
        $('#loader').hide();
    }
</script>
<script src="~/assets/libs/chart.js/chart.min.js"></script>
<script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
<script src="~/assets/js/apexcharts-pie.js"></script>
<script>
    var pieChartData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(_objPieChartData));
    if (pieChartData != null)
    {
        var seriesData = pieChartData.map(function (x) {
            return parseFloat(x.BlockValues);
        });

        var labelData = pieChartData.map(function (x) {
            return x.Ageing;
        });

        var options = {
            series: seriesData,
            chart: {
                height: 300,
                type: 'pie'
            },
            colors: ["#8e54e9", "#4876e6", "#f5b849", "#49b6f5", "#e6533c"],
            labels: labelData,
            legend: {
                position: "bottom"
            },
            dataLabels: {
                enabled: false,
                dropShadow: {
                    enabled: false
                }
            }
        };

        var chart = new ApexCharts(
            document.querySelector("#pie-Grossbasic"),
            options
        );

        chart.render();

        var seriesData = pieChartData.map(function (x) {
            return parseFloat(x.NetValues);
        });

        var labelData = pieChartData.map(function (x) {
            return x.Ageing;
        });

        var options = {
            series: seriesData,
            chart: {
                height: 300,
                type: 'pie'
            },
            colors: ["#8e54e9", "#4876e6", "#f5b849", "#49b6f5", "#e6533c"],
            labels: labelData,
            legend: {
                position: "bottom"
            },
            dataLabels: {
                enabled: false,
                dropShadow: {
                    enabled: false
                }
            }
        };

        var chart = new ApexCharts(
            document.querySelector("#pie-Netbasic"),
            options
        );

        chart.render();
    }

</script>

<script>
