@model AssetsManagement_Admin.Operations.FilterRequest
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_Layout.cshtml";
}

@{
    var json = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DashboardChart);
    List<AssetsManagement_Admin.Areas.SuperAdmin.Data.PieChartData> _objPieChartData = null;
    List<AssetsManagement_Admin.Areas.SuperAdmin.Data.BarChartData> _objYBarChartData = null;
    List<AssetsManagement_Admin.Areas.SuperAdmin.Data.BarChartData> _objNBarChartData = null;
    if (json != "null")
    {
        AssetsManagement_Admin.Areas.SuperAdmin.Data.DashboardChart chartData = Newtonsoft.Json.JsonConvert.DeserializeObject<AssetsManagement_Admin.Areas.SuperAdmin.Data.DashboardChart>(json);

        _objPieChartData = chartData.objPieChartData;
        _objYBarChartData = chartData.objYBarChartData;
        _objNBarChartData = chartData.objNBarChartData;
    }
}

<br />
@using (Html.BeginForm("Index", "Dashboard", FormMethod.Post))
{
    <div class="row">
        <div class="form-group col-md-3">
            <label>Company</label>
            <div class="p-2">
                @Html.DropDownListFor(
                    x => x.CompanyId,
                    (SelectList)ViewBag.Company,
                    "All",
                    new
                    {
                        @class = "form-select",
                        id = "CompanyId",
                        onchange = "ddlchange()"
                    })
            </div>
        </div>
        <div class="form-group col-md-3">
            <label>Branch</label>
            <div class="p-2">
                @Html.DropDownListFor(
                    x => x.BranchName,
                    (SelectList)ViewBag.VendorBranch,
                    "All",
                    new
                    {
                        @class = "form-select",
                        id = "VendorBranch",
                        disabled = "disabled",
                        onchange = "ddlchange()"
                    })
            </div>
        </div>
        <div class="form-group col-md-3">
            <label>Region</label>
            <div class="p-2">
                @Html.DropDownListFor(
                    x => x.Region,
                    (SelectList)ViewBag.Region,
                    "All",
                    new
                    {
                        @class = "form-select",
                        id = "Region",
                        disabled = "disabled",
                        onchange = "ddlchange()"
                    })
            </div>
        </div>
        <div class="form-group col-md-3">
            <label>State</label>
            <div class="p-2">
                @Html.DropDownListFor(
                    x => x.State,
                    (SelectList)ViewBag.State,
                    "All",
                    new
                    {
                        @class = "form-select",
                        id = "State",
                        disabled = "disabled",
                        onchange = "ddlchange()"
                    })
            </div>
        </div>

        <div class="form-group col-md-3 mt-4">
            <input type="submit" value="Search" class="btn btn-primary" />
        </div>

    </div>
}
@if (_objPieChartData != null)
{
    <hr />
    <br />
    <h2>Block Pie Chart</h2>
    <br />
    <div class="row">

        <div class="col-md-3">
            <h5>Gross Block Pie Chart</h5>
            <div id="pie-Grossbasic"></div>
        </div>
        <div class="col-md-6">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table text-nowrap table-bordered">
                        <thead class="table-secondary">
                            <tr>
                                <th scope="col">Ageing</th>
                                <th scope="col">Gross Block</th>
                                <th scope="col">Net Block</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_objPieChartData == null)
                            {
                                <tr>
                                    <td colspan="3">No Records</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in _objPieChartData)
                                {
                                    <tr>
                                        <td>@item.Ageing</td>
                                        <td>@item.BlockValues</td>
                                        <td>@item.NetValues</td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <h5>Net Block Pie Chart</h5>
            <div id="pie-Netbasic"></div>
        </div>
    </div>
}
@if (_objYBarChartData != null)
{
    <br />
    <hr />
    <h2>Gross Bar Chart</h2>
    <div class="row">
        <div class="col-md-12">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table text-nowrap table-bordered">
                        <thead class="table-secondary">
                            <tr>
                                <th scope="col">Asset Age</th>
                                <th scope="col">Gross Block</th>
                                <th scope="col">WDV</th>
                                <th scope="col">Gross block %</th>
                                <th scope="col">WDV %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_objYBarChartData == null)
                            {
                                <tr>
                                    <td colspan="5">No Records</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in _objYBarChartData)
                                {
                                    <tr>
                                        <th scope="row">@item.Ageing</th>
                                        <td>@item.BlockValues</td>
                                        <td>@item.NetValues</td>
                                        <td>@item.BlockValuePercentage%</td>
                                        <td>@item.NetValuePercentage%</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            @if (_objYBarChartData != null)
            {
                <div id="column-basic"></div>
            }
        </div>
        <div class="col-md-6">
            @if (_objYBarChartData != null)
            {
                <div id="column-percentagebasic"></div>
            }
        </div>

    </div>
}
