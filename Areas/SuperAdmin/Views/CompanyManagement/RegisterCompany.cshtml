@model AssetsManagement_Admin.Areas.SuperAdmin.Data.Company
@{
    ViewBag.Title = "RegisterCompany";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_Layout.cshtml";
}

<script>
document.addEventListener('DOMContentLoaded', function () {

    var toastSuccess = document.getElementById('solid-successToast');
    var toastDanger  = document.getElementById('solid-dangerToast');
    var toastInfo    = document.getElementById('solid-infoToast');

    @* SUCCESS *@
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            if (toastSuccess) {
                new bootstrap.Toast(toastSuccess).show();
            }
        </text>
    }

    @* ERROR *@
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            if (toastDanger) {
                new bootstrap.Toast(toastDanger).show();
            }
        </text>
    }

    @* INFO *@
    @if (TempData["InfoMessage"] != null)
    {
        <text>
            if (toastInfo) {
                new bootstrap.Toast(toastInfo).show();
            }
        </text>
    }

});
</script>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="solid-successToast" class="toast colored-toast bg-success text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-success text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["SuccessMessage"]
        </div>
    </div>
    <div id="solid-dangerToast" class="toast colored-toast bg-danger text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-danger text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["ErrorMessage"]
        </div>
    </div>
    <div id="solid-infoToast" class="toast colored-toast bg-info text-fixed-white" role="alert" aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header bg-info text-fixed-white">
            <img class="bd-placeholder-img rounded me-2" src="~/assets/images/brand-logos/toggle-dark.png" alt="...">
            <strong class="me-auto">Message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["InfoMessage"]
        </div>
    </div>
</div>


<div class="row row-sm">
    <div class="col-lg-12">
        <div class="card">
            @using (Html.BeginForm("RegisterCompany", "CompanyManagement", new { area = "SuperAdmin" }, FormMethod.Post, new { @class = "max-width-auto", @id = "RegisterCompany" }))
            {
                <div class="card-body">
                    <div class="mb-4 main-content-label">Company Information</div>
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Name *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.TextBoxFor(m => m.CompanyName, new { @class = "form-control", @placeholder = "Company Name", autocomplete = "off", onkeypress = "return isTextOnly(event)" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Contact Person *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.TextBoxFor(m => m.CompanyContactPerson, new { @class = "form-control", @placeholder = "Company Contact Person", autocomplete = "off", onkeypress = "return isTextOnly(event)" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Contact Person Number *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.TextBoxFor(m => m.CompanyContactNumber, new { @class = "form-control", @placeholder = "Company Contact Person Number", autocomplete = "off", maxlength = "10", onkeypress = "return isNumber(event)" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <label class="form-label">Contact Person Email *</label>
                            </div>
                            <div class="form-group col-md-9">
                                @Html.TextBoxFor(m => m.CompanyContactEmail, new { @class = "form-control", @placeholder = "Company Contact Person Email", autocomplete = "off" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Contact Person 2</label>
                        </div>
                        <div class="form-group col-md-9">
                            @Html.TextBoxFor(m => m.CompanyContactPerson2, new { @class = "form-control", @placeholder = "Company Contact Person 2", autocomplete = "off", onkeypress = "return isTextOnly(event)" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Contact Person Number 2</label>
                        </div>
                        <div class="form-group col-md-9">
                            @Html.TextBoxFor(m => m.CompanyContactNumber2, new { @class = "form-control", @placeholder = "Company Contact Person Number 2", autocomplete = "off", maxlength = "10", onkeypress = "return isNumber(event)" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Contact Person Email 2</label>
                        </div>
                        <div class="form-group col-md-9">
                            @Html.TextBoxFor(m => m.CompanyContactEmail2, new { @class = "form-control", @placeholder = "Company Contact Person Email 2", autocomplete = "off" })
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Contact Person 3</label>
                        </div>
                        <div class="form-group col-md-9">
                            @Html.TextBoxFor(m => m.CompanyContactPerson3, new { @class = "form-control", @placeholder = "Company Contact Person 3 ", autocomplete = "off", onkeypress = "return isTextOnly(event)" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Contact Person Number 3</label>
                        </div>
                        <div class="form-group col-md-9">
                            @Html.TextBoxFor(m => m.CompanyContactNumber3, new { @class = "form-control", @placeholder = "Company Contact Person Number 3", autocomplete = "off", maxlength = "10", onkeypress = "return isNumber(event)" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Contact Person Email 3</label>
                        </div>
                        <div class="form-group col-md-9">
                            @Html.TextBoxFor(m => m.CompanyContactEmail3, new { @class = "form-control", @placeholder = "Company Contact Person Email 3", autocomplete = "off" })
                        </div>
                    </div>

                </div>


                <div class="card-footer">
                    <button type="submit" class="btn btn-primary waves-effect waves-light">Register Company</button>
                </div>
            }
        </div>
    </div>
</div>
<script src="~/assets/js/jquery/jquery.js"></script>
<script src="~/assets/js/jquery-validation/jquery.validate.min.js"></script>
<script src="~/assets/js/form-validation.js"></script>
<script>
    $(document).ready(function () {
        $('#RegisterCompany').validate($.extend({}, window.formValidationDisplay, {
            rules: {
                CompanyName: {
                    required: true,
                    notBlank: true,
                    minlength: 2,
                    maxlength: 100,
                },
                CompanyContactPerson: {
                    required: true,
                    notBlank: true,
                    lettersOnly: true,
                    maxlength: 100,
                },
                CompanyContactNumber: {
                    required: true,
                    tenDigitMobile: true,
                },
                CompanyContactEmail: {
                    required: true,
                    validEmail: true,
                    maxlength: 100,
                },
                CompanyContactPerson2: { lettersOnly: true, maxlength: 100 },
                CompanyContactNumber2: { tenDigitMobile: true },
                CompanyContactEmail2: { validEmail: true, maxlength: 100 },
                CompanyContactPerson3: { lettersOnly: true, maxlength: 100 },
                CompanyContactNumber3: { tenDigitMobile: true },
                CompanyContactEmail3: { validEmail: true, maxlength: 100 },
            },
            messages: {
                CompanyName: {
                    required: "Please enter the Name",
                    notBlank: "Please enter the Name",
                    minlength: "Name must be at least 2 characters",
                    maxlength: "Name cannot be longer than 100 characters",
                },
                CompanyContactPerson: {
                    required: "Please enter the Contact Person",
                    notBlank: "Please enter the Contact Person",
                    maxlength: "Contact Person cannot be longer than 100 characters",
                },
                CompanyContactNumber: {
                    required: "Please enter the Contact Person Number",
                },
                CompanyContactEmail: {
                    required: "Please enter the Contact Person Email",
                    maxlength: "Email cannot be longer than 100 characters",
                },
            },
        }));
    });
</script>

<script>
    function isNumber(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;
        if (charCode < 48 || charCode > 57) {
            return false;
        }
        return true;
    }
</script>

<script>
    function isTextOnly(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;

        // Allow A-Z (65-90), a-z (97-122), and space (32)
        if (
            (charCode >= 65 && charCode <= 90) ||
            (charCode >= 97 && charCode <= 122) ||
            charCode === 32
        ) {
            return true;
        }
        return false;
    }
</script>