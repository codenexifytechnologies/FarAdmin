@model AssetsManagement_Admin.Operations.FilterRequest
@{
    ViewBag.Title = "AssetList";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_Layout.cshtml";


    List<AssetsManagement_Admin.Areas.SuperAdmin.Data.AssetData> _lstAssetData = ViewBag.lstAssetData;
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.3.0/css/responsive.bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.bootstrap5.min.css">
<link href="~/assets/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

@using (Html.BeginForm("AssetList", "Asset", FormMethod.Post))
{
    <div class="row">
        <div class="form-group col-md-3">
            <label>Company</label>
            <div class="p-2">
                @Html.DropDownListFor(
                    x => x.CompanyId,
                    (SelectList)ViewBag.Company,
                    "All",
                    new
                    {
                        @class = "form-select",
                        id = "CompanyId",
                        onchange = "ddlchange()"
                    })
            </div>
        </div>
        <div class="form-group col-md-3">
            <label>Branch</label>
            <div class="p-2">
                @Html.DropDownListFor(
                    x => x.BranchName,
                    (SelectList)ViewBag.VendorBranch,
                    "All",
                    new
                    {
                        @class = "form-select",
                        id = "VendorBranch",
                        disabled = "disabled",
                        onchange = "ddlchange()"
                    })
            </div>
        </div>

        <div class="form-group col-md-3 mt-4">
            <input type="submit" value="Search" class="btn btn-primary" />
        </div>

    </div>
}

@if (_lstAssetData != null)
{
    <table id="file-export" class="table table-bordered text-nowrap" style="width:100%">
        <thead>
            <tr>
                <th scope="col">Asset Number</th>
                <th scope="col">Asset Discription</th>
                <th scope="col">Barcode Number</th>
                <th scope="col">Category</th>
                <th scope="col">Type</th>
                <th scope="col">Subtype</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _lstAssetData)
            {
                <tr>
                    <td>@item.ASSET_NUMBER</td>
                    <td>@item.ASSET_DESCRIPTION</td>
                    <td>@item.BarcodeNo</td>
                    <td>@item.TYPE</td>
                    <td>@item.TYPE_URCFO</td>
                    <td>@item.SUBTYPE_URCFO</td>
                    <td>
                        <a href="@Url.Action("AssetListById", "Asset", new{id = item.Id})"><i class="fa-user-edit"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<script src="~/assets/js/jquery/jquery.js"></script>
<script src="~/assets/js/jquery-validation/jquery.validate.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.1.min.js" integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ=" crossorigin="anonymous"></script>

<!-- Datatables Cdn -->
<script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.3.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.print.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<!-- Internal Datatables JS -->
<script src="~/assets/js/datatables.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        var companyId = $('#CompanyId').val();

        if (companyId > 0) {

            $("#VendorBranch").prop("disabled", false);
        }
        else {
            $("#VendorBranch").prop("disabled", true);
        }
    });


    function ddlchange() {
        $('#loader').show();
        var companyId = $('#CompanyId').val();

        if (companyId > 0) {

            $("#VendorBranch").prop("disabled", false);

            // STORE CURRENT SELECTED VALUES
            var branchname = $('#VendorBranch').val();

            // CLEAR DROPDOWNS
            $("#VendorBranch").empty().append('<option value="">All</option>');
            $("#Region").empty().append('<option value="">All</option>');

            $.ajax({
                url: '@Url.Action("getFilterData", "Dashboard")',
                type: 'GET',
                data: {
                    CompanyID: companyId,
                    BranchName: branchname
                },
                success: function (data) {
                    // VendorBranch
                    $.each(data.data[0], function (i, item) {

                        var selected = (item.Value == branchname) ? 'selected' : '';

                        $("#VendorBranch").append(
                            '<option value="' + item.Value + '" ' + selected + '>' +
                            item.Text +
                            '</option>'
                        );
                    });


                },
                error: function () {
                    alert("Failed to load.");
                }
            });
        }
        else {

            $("#VendorBranch").prop("disabled", true);
            $("#Region").prop("disabled", true);

        }
        $('#loader').hide();
    }
</script>

